/* Oxocarbon theme switcher — grid layout */

configuration {
    show-icons:    true;
    display-dmenu: "  Themes";
    icon-size:     310;
}

* {
    font:          "JetBrainsMono Nerd Font 11";

    /* Oxocarbon palette */
    base:          #161616ff;
    surface:       #262626ff;
    overlay:       #393939ff;
    muted:         #525252ff;
    subtle:        #6f6f6fff;
    text:          #f2f4f8ff;
    subtext:       #dde1e6ff;
    blue:          #78a9ffff;
    purple:        #be95ffff;
    teal:          #08bdbaff;
    pink:          #ff7eb6ff;

    transparent:   #00000000;
    blue-dim:      #78a9ff20;
    blue-border:   #78a9ff50;
    purple-dim:    #be95ff15;
    purple-border: #be95ff45;
}

window {
    background-color: @transparent;
    border:           0;
    width:            1060px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @surface;
    border-radius:    20px;
    border:           2px solid;
    border-color:     @blue-border;
    padding:          18px;
    spacing:          0;
    children:         [inputbar, listview];
}

inputbar {
    background-color: @surface;
    border-radius:    16px;
    border:           1px solid;
    border-color:     @purple-border;
    padding:          12px 16px;
    margin:           0 0 14px 0;
    children:         [prompt, entry];
    spacing:          10px;
}

prompt {
    background-color: @transparent;
    text-color:       @purple;
    font:             "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: @transparent;
    text-color:       @teal;
    cursor:           text;
    placeholder:      "/ to search…";
    placeholder-color: @muted;
}

listview {
    background-color: @transparent;
    columns:          3;
    lines:            2;
    scrollbar:        false;
    spacing:          12px;
    fixed-height:     true;
}

element {
    background-color: @transparent;
    border-radius:    14px;
    border:           1px solid;
    border-color:     @transparent;
    padding:          0px;
    spacing:          0px;
    orientation:      vertical;
    children:         [element-icon, element-text];
}

element normal normal {
    background-color: @transparent;
    border-color:     @transparent;
}

element selected normal {
    background-color: @purple-dim;
    border-color:     @blue-border;
}

element normal urgent {
    background-color: @transparent;
}

element selected urgent {
    background-color: @blue-dim;
    border-color:     @blue-border;
}

element-icon {
    background-color: @transparent;
    border-radius:    14px 14px 0px 0px;
    size:             240px;
}

element-text {
    background-color: @blue-dim;
    text-color:       @teal;
    font:             "JetBrainsMono Nerd Font Bold 13";
    horizontal-align: 0.5;
    vertical-align:   0.5;
    padding:          6px 8px;
}

element-text selected {
    text-color: @blue;
}
