/* Generated by theme-switcher — do not edit manually */
* {
    /* Shared backgrounds / foregrounds */
    r-bg0:           #161616d9;
    r-bg1:           #262626d9;
    r-fg0:           #dde1e6;
    r-fg1:           #f2f4f8;
    r-bg3:           #525252;

    /* Launcher */
    r-base:          #161616ff;
    r-surface:       #262626ff;
    r-overlay:       #393939ff;
    r-muted:         #525252ff;
    r-text:          #f2f4f8ff;
    r-subtext:       #dde1e6ff;
    r-blue:          #78a9ffff;
    r-purple:        #be95ffff;
    r-teal:          #3ddbd9ff;
    r-blue-dim:      #78a9ff20;
    r-blue-border:   #78a9ff50;
    r-purple-dim:    #be95ff15;
    r-purple-border: #be95ff45;

    /* Wallpaper switcher */
    r-wp-accent:     #ee5396;
    r-wp-al:         #ff7eb6;
    r-wp-b1:         #ee539640;
    r-wp-b2:         #ff7eb659;
    r-wp-sel:        #ee539626;
    r-wp-sel-b:      #ee539680;
    r-wp-icon:       #ee539619;

    /* Theme switcher */
    r-ts-accent:     #78a9ff;
    r-ts-al:         #33b1ff;
    r-ts-b1:         #78a9ff40;
    r-ts-b2:         #33b1ff59;
    r-ts-sel:        #78a9ff26;
    r-ts-sel-b:      #78a9ff80;
    r-ts-icon:       #78a9ff19;

    /* Power menu */
    r-pm-bg0:        #161616e6;
    r-pm-bg1:        #262626e6;
    r-pm-accent:     #78a9ff;
    r-pm-al:         #33b1ff;
    r-pm-b1:         #78a9ff40;
    r-pm-b2:         #33b1ff59;
    r-pm-sel:        #33b1ff26;
    r-pm-sel-b:      #33b1ff80;

    /* Keybinds (reuses launcher vars + extras) */
    r-subtle:        #dde1e6ff;
    r-pink:          #ee5396ff;

    /* Notification center */
    r-nc-bg0:        #161616ee;
    r-nc-bg1:        #262626ee;
    r-nc-accent:     #78a9ff;
    r-nc-adim:       #78a9ff30;
    r-nc-aborder:    #78a9ff50;
    r-nc-muted:      #525252;
}
