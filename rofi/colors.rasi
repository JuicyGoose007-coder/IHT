/* Generated by theme-switcher — do not edit manually */
* {
    /* Shared backgrounds / foregrounds */
    r-bg0:           #0e0e13d9;
    r-bg1:           #1b1b21d9;
    r-fg0:           #c8c5d0;
    r-fg1:           #e5e1e9;
    r-bg3:           #2a292f;

    /* Launcher */
    r-base:          #0e0e13ff;
    r-surface:       #1b1b21ff;
    r-overlay:       #201f25ff;
    r-muted:         #2a292fff;
    r-text:          #e5e1e9ff;
    r-subtext:       #c8c5d0ff;
    r-blue:          #c3c0ffff;
    r-purple:        #c7c4ddff;
    r-teal:          #464559ff;
    r-blue-dim:      #c3c0ff20;
    r-blue-border:   #c3c0ff50;
    r-purple-dim:    #c7c4dd15;
    r-purple-border: #c7c4dd45;

    /* Wallpaper switcher */
    r-wp-accent:     #ffb4ab;
    r-wp-al:         #eab9d1;
    r-wp-b1:         #ffb4ab40;
    r-wp-b2:         #eab9d159;
    r-wp-sel:        #ffb4ab26;
    r-wp-sel-b:      #ffb4ab80;
    r-wp-icon:       #ffb4ab19;

    /* Theme switcher */
    r-ts-accent:     #c3c0ff;
    r-ts-al:         #c3c0ff;
    r-ts-b1:         #c3c0ff40;
    r-ts-b2:         #c3c0ff59;
    r-ts-sel:        #c3c0ff26;
    r-ts-sel-b:      #c3c0ff80;
    r-ts-icon:       #c3c0ff19;
}
