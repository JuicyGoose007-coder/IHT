/* Generated by theme-switcher — do not edit manually */
* {
    /* Shared backgrounds / foregrounds */
    r-bg0:           #0d0e13d9;
    r-bg1:           #1a1b21d9;
    r-fg0:           #c5c6d0;
    r-fg1:           #e3e2e9;
    r-bg3:           #292a2f;

    /* Launcher */
    r-base:          #0d0e13ff;
    r-surface:       #1a1b21ff;
    r-overlay:       #1e1f25ff;
    r-muted:         #292a2fff;
    r-text:          #e3e2e9ff;
    r-subtext:       #c5c6d0ff;
    r-blue:          #b2c5ffff;
    r-purple:        #c0c6ddff;
    r-teal:          #404659ff;
    r-blue-dim:      #b2c5ff20;
    r-blue-border:   #b2c5ff50;
    r-purple-dim:    #c0c6dd15;
    r-purple-border: #c0c6dd45;

    /* Wallpaper switcher */
    r-wp-accent:     #ffb4ab;
    r-wp-al:         #e1bbdc;
    r-wp-b1:         #ffb4ab40;
    r-wp-b2:         #e1bbdc59;
    r-wp-sel:        #ffb4ab26;
    r-wp-sel-b:      #ffb4ab80;
    r-wp-icon:       #ffb4ab19;

    /* Theme switcher */
    r-ts-accent:     #b2c5ff;
    r-ts-al:         #b2c5ff;
    r-ts-b1:         #b2c5ff40;
    r-ts-b2:         #b2c5ff59;
    r-ts-sel:        #b2c5ff26;
    r-ts-sel-b:      #b2c5ff80;
    r-ts-icon:       #b2c5ff19;

    /* Power menu */
    r-pm-bg0:        #0d0e13e6;
    r-pm-bg1:        #1a1b21e6;
    r-pm-accent:     #b2c5ff;
    r-pm-al:         #b2c5ff;
    r-pm-b1:         #b2c5ff40;
    r-pm-b2:         #b2c5ff59;
    r-pm-sel:        #b2c5ff26;
    r-pm-sel-b:      #b2c5ff80;

    /* Keybinds (reuses launcher vars + extras) */
    r-subtle:        #c5c6d0ff;
    r-pink:          #ffb4abff;

    /* Notification center */
    r-nc-bg0:        #0d0e13ee;
    r-nc-bg1:        #1a1b21ee;
    r-nc-accent:     #b2c5ff;
    r-nc-adim:       #b2c5ff30;
    r-nc-aborder:    #b2c5ff50;
    r-nc-muted:      #292a2f;
}
