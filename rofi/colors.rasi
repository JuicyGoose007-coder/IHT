/* Generated by theme-switcher — do not edit manually */
* {
    /* Shared backgrounds / foregrounds */
    r-bg0:           #120c10d9;
    r-bg1:           #201a1ed9;
    r-fg0:           #d2c2ca;
    r-fg1:           #eddfe4;
    r-bg3:           #2f282c;

    /* Launcher */
    r-base:          #120c10ff;
    r-surface:       #201a1eff;
    r-overlay:       #251e22ff;
    r-muted:         #2f282cff;
    r-text:          #eddfe4ff;
    r-subtext:       #d2c2caff;
    r-blue:          #f7b1deff;
    r-purple:        #ddbecfff;
    r-teal:          #57404eff;
    r-blue-dim:      #f7b1de20;
    r-blue-border:   #f7b1de50;
    r-purple-dim:    #ddbecf15;
    r-purple-border: #ddbecf45;

    /* Wallpaper switcher */
    r-wp-accent:     #ffb4ab;
    r-wp-al:         #f5b9a1;
    r-wp-b1:         #ffb4ab40;
    r-wp-b2:         #f5b9a159;
    r-wp-sel:        #ffb4ab26;
    r-wp-sel-b:      #ffb4ab80;
    r-wp-icon:       #ffb4ab19;

    /* Theme switcher */
    r-ts-accent:     #f7b1de;
    r-ts-al:         #f7b1de;
    r-ts-b1:         #f7b1de40;
    r-ts-b2:         #f7b1de59;
    r-ts-sel:        #f7b1de26;
    r-ts-sel-b:      #f7b1de80;
    r-ts-icon:       #f7b1de19;

    /* Power menu */
    r-pm-bg0:        #120c10e6;
    r-pm-bg1:        #201a1ee6;
    r-pm-accent:     #f7b1de;
    r-pm-al:         #f7b1de;
    r-pm-b1:         #f7b1de40;
    r-pm-b2:         #f7b1de59;
    r-pm-sel:        #f7b1de26;
    r-pm-sel-b:      #f7b1de80;

    /* Keybinds (reuses launcher vars + extras) */
    r-subtle:        #d2c2caff;
    r-pink:          #ffb4abff;

    /* Notification center */
    r-nc-bg0:        #120c10ee;
    r-nc-bg1:        #201a1eee;
    r-nc-accent:     #f7b1de;
    r-nc-adim:       #f7b1de30;
    r-nc-aborder:    #f7b1de50;
    r-nc-muted:      #2f282c;
}
