layout {

    focus-ring {
        active-color   "#f7b1de"
        inactive-color "#120c10"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#f7b1de"
        inactive-color "#120c10"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#f7b1de"
        inactive-color "#7b586f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#f7b1de80"
    }
}

recent-windows {
    highlight {
        active-color "#f7b1de"
        urgent-color "#ffb4ab"
    }
}
