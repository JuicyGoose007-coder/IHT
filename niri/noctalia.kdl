layout {

    focus-ring {
        active-color   "#81d3de"
        inactive-color "#090f10"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#81d3de"
        inactive-color "#090f10"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#81d3de"
        inactive-color "#40696f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#81d3de80"
    }
}

recent-windows {
    highlight {
        active-color "#81d3de"
        urgent-color "#ffb4ab"
    }
}
